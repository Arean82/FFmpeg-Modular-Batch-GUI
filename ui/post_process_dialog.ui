<ui version="4.0">
 <class>PostProcessDialog</class>
 <widget class="QDialog" name="PostProcessDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>560</width>
    <height>380</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Post-Processing Hooks &amp; External Commands</string>
  </property>
  <layout class="QVBoxLayout" name="mainPostLayout">
   <item>
    <widget class="QGroupBox" name="grpPerFile">
     <property name="title">
      <string>Action On Each Successfully Encoded File</string>
     </property>
     <layout class="QVBoxLayout" name="perFileLayout">
      <item>
       <widget class="QCheckBox" name="chkRunPerFile">
        <property name="text">
         <string>Execute custom shell command after each item finishes</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLineEdit" name="txtPerFileCmd">
        <property name="placeholderText">
         <string>e.g.: /usr/bin/notify-send "Finished {output}" or my_script.sh "{output}"</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="lblTokensPerFile">
        <property name="text">
         <string>Available tokens: {input} (source path), {output} (target path), {status}</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="grpOnComplete">
     <property name="title">
      <string>Action On Full Queue Completion</string>
     </property>
     <layout class="QVBoxLayout" name="onCompleteLayout">
      <item>
       <widget class="QCheckBox" name="chkRunOnComplete">
        <property name="text">
         <string>Execute custom shell command when entire queue is finished</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLineEdit" name="txtOnCompleteCmd">
        <property name="placeholderText">
         <string>e.g.: notify-send "Batch Done!" or python3 /path/to/upload.py</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <spacer name="vSpacerPost">
     <property name="orientation">
      <enum>Qt::Vertical</enum>
     </property>
     <property name="sizeHint" stdset="0">
      <size>
       <width>20</width>
       <height>10</height>
      </size>
     </property>
    </spacer>
   </item>
   <item>
    <layout class="QHBoxLayout" name="buttonsLayout">
     <item>
      <spacer name="hSpacerPost">
       <property name="orientation">
        <enum>Qt::Horizontal</enum>
       </property>
       <property name="sizeHint" stdset="0">
        <size>
         <width>40</width>
